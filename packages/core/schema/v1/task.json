{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:task:v1",
  "title": "Tacet Task",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "A2A Task.id, generated by the Mini-conductor"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "usd": {
          "description": "Hard cap on spend for the task, in US dollars",
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "description": "Hard cap on total tokens for the task",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "priority": {
      "default": "p2",
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "parentId": {
      "description": "Parent task, carried as A2A referenceTaskIds",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contextId": {
      "description": "A2A contextId: the cross-repo goal or workflow",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "goal",
    "acceptanceCriteria",
    "createdAt"
  ]
}
