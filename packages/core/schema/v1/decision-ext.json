{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:decision-ext:v1",
  "title": "Tacet A2A decision extension (urn:tacet:a2a-ext:decision:v1)",
  "type": "object",
  "properties": {
    "escalationId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "choice": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "task",
        "repo"
      ],
      "x-tacet-fallback": "task",
      "type": "string"
    },
    "code": {
      "description": "The Escalation's one-time answer code, which only the terminal of the run that asked shows: a Mini-conductor's control port takes no answer without it (#269)",
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "escalationId",
    "choice",
    "scope"
  ]
}
