{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:worker-review:v1",
  "title": "Tacet worker.review payload",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "The author Worker's session"
    },
    "reviewerSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "not_run",
        "error"
      ],
      "x-tacet-fallback": "failed",
      "type": "string"
    },
    "blockers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "majors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "commit": {
      "description": "The integrated commit that was reviewed",
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    }
  },
  "required": [
    "sessionId",
    "round",
    "adapter",
    "status",
    "blockers",
    "majors",
    "minors",
    "durationMs"
  ]
}
