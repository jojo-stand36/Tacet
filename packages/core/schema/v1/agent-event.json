{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:agent-event:v1",
  "title": "Tacet AgentEvent",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "message.delta"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "tool.call"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {}
      },
      "required": [
        "t",
        "id",
        "name",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "tool.result"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ok": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "id",
        "ok"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "approval.request"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "toolName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "t",
        "id",
        "summary"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "usage"
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "reported",
            "estimated"
          ]
        }
      },
      "required": [
        "t",
        "inputTokens",
        "outputTokens",
        "source"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "status"
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "idle",
            "waiting_input",
            "cancelled",
            "error",
            "done"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "escalation"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "urgency": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high",
            "blocking"
          ]
        }
      },
      "required": [
        "t",
        "question",
        "urgency"
      ]
    }
  ]
}
