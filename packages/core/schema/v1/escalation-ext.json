{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:escalation-ext:v1",
  "title": "Tacet A2A escalation extension (urn:tacet:a2a-ext:escalation:v1)",
  "type": "object",
  "properties": {
    "escalationId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "blocking"
      ]
    },
    "blockedWorkers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contextRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "escalationId",
    "urgency",
    "blockedWorkers"
  ]
}
