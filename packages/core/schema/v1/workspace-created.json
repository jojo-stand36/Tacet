{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:workspace-created:v1",
  "title": "Tacet workspace.created payload",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "baseBranch": {
      "type": "string",
      "minLength": 1
    },
    "migrated": {
      "type": "boolean",
      "const": true
    },
    "scratch": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "workspaceId",
    "workerId",
    "baseCommit"
  ]
}
