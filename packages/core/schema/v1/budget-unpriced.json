{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:budget-unpriced:v1",
  "title": "Tacet budget.unpriced payload",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "escalationId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "allowed": {
      "type": "boolean"
    },
    "withdrawn": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "model"
  ]
}
