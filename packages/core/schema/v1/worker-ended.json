{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:worker-ended:v1",
  "title": "Tacet worker.ended payload",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reason": {
      "enum": [
        "finished",
        "failed",
        "stuck",
        "restart",
        "canceled",
        "handoff"
      ],
      "x-tacet-fallback": "failed",
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "workspaceRefused": {
      "description": "Its checkout failed the integrity checks; the next run gets a fresh one (#119)",
      "type": "boolean"
    }
  },
  "required": [
    "sessionId"
  ]
}
