{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:worker-integrated:v1",
  "title": "Tacet worker.integrated payload",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "ref": {
      "type": "string",
      "pattern": "^refs\\/heads\\/\\S+$"
    },
    "by": {
      "description": "Who made the commit: the Worker, or Tacet, from the changes in the checkout of a Worker that cannot run git (#260), as 'Tacet Worker'. Absent in older events, and when a retry integrates the checkout's HEAD, which may be Tacet's commit of an earlier attempt (its author says)",
      "enum": [
        "worker",
        "tacet"
      ],
      "x-tacet-fallback": "worker",
      "type": "string"
    }
  },
  "required": [
    "sessionId",
    "commit",
    "ref"
  ]
}
