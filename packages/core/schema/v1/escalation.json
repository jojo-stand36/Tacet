{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:escalation:v1",
  "title": "Tacet Escalation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sessionId": {
      "description": "Worker session that raised it",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "blocking"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "decision",
        "help",
        "blocked",
        "failed",
        "emergency",
        "gate_timeout",
        "lifecycle"
      ]
    },
    "context": {
      "description": "Short free-text context from the Worker",
      "type": "string"
    },
    "contextRef": {
      "description": "Pointer to larger context, e.g. a file path",
      "type": "string",
      "minLength": 1
    },
    "blockedWorkers": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "default": "pending",
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "expired",
        "cancelled"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "staleAfterSeconds": {
      "description": "Re-escalate if still pending after this many seconds",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxReescalations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reescalations": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "question",
    "urgency",
    "createdAt"
  ]
}
