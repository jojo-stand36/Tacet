{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:worker-verification:v1",
  "title": "Tacet worker.verification payload",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "timed_out",
        "aborted",
        "not_run"
      ],
      "x-tacet-fallback": "failed",
      "type": "string"
    },
    "exitCode": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "signal": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "commit": {
      "description": "The integrated commit the checkout was verified at",
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    }
  },
  "required": [
    "sessionId",
    "round",
    "command",
    "status",
    "durationMs"
  ]
}
