{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:worker-started:v1",
  "title": "Tacet worker.started payload",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Tacet Worker session id"
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "description": "Worktree id in the worktree registry",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "attempt": {
      "description": "1 for the first run of a sub-task",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "previousSessionId": {
      "description": "The session this one replaces (restart, handoff or retry), like AG-UI parentRunId",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "sessionId"
  ]
}
