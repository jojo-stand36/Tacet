{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:task-ext:v1",
  "title": "Tacet A2A task extension (urn:tacet:a2a-ext:task:v1)",
  "type": "object",
  "properties": {
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "usd": {
          "description": "Hard cap on spend for the task, in US dollars",
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "description": "Hard cap on total tokens for the task",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "priority": {
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ],
      "x-tacet-fallback": "p2",
      "type": "string"
    },
    "autonomy": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "x-tacet-fallback": "low",
      "type": "string"
    },
    "tiers": {
      "description": "Tier overrides keyed by role",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "acceptanceCriteria"
  ]
}
