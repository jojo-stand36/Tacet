{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:tacet-event-params:v1",
  "title": "Tacet tacet/event params",
  "type": "object",
  "properties": {
    "logId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "throughSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "logId",
    "throughSeq",
    "events"
  ]
}
