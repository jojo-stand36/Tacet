{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:worker-profile:v1",
  "title": "Tacet worker.profile payload",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contextWindow": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reasons": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Why each part was chosen, in order"
    },
    "refused": {
      "description": "The adapter refused this profile (ProfileRefusedError)",
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "model, effort or contextWindow"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "message"
      ]
    }
  },
  "required": [
    "sessionId",
    "reasons"
  ]
}
