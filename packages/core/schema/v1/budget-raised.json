{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacet:schema:budget-raised:v1",
  "title": "Tacet budget.raised payload",
  "type": "object",
  "properties": {
    "scope": {
      "enum": [
        "task",
        "day",
        "month"
      ],
      "x-tacet-fallback": "task",
      "type": "string"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capUsd": {
      "type": "number",
      "minimum": 0
    },
    "escalationId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  },
  "required": [
    "scope",
    "key",
    "capUsd"
  ]
}
