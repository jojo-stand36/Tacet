{
  "name": "@tacet/mini",
  "version": "0.0.0",
  "private": true,
  "description": "Per-repo Mini-conductor daemon and MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@tacet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workers": {
      "@tacet/source": "./src/workers/index.ts",
      "types": "./dist/workers/index.d.ts",
      "default": "./dist/workers/index.js"
    },
    "./standalone": {
      "@tacet/source": "./src/standalone.ts",
      "types": "./dist/standalone.d.ts",
      "default": "./dist/standalone.js"
    },
    "./testing": {
      "@tacet/source": "./src/daemon/testing.ts",
      "types": "./dist/daemon/testing.d.ts",
      "default": "./dist/daemon/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@tacet/adapter-acp": "workspace:*",
    "@tacet/adapter-claude-sdk": "workspace:*",
    "@tacet/adapter-codex-app-server": "workspace:*",
    "@tacet/adapter-pty": "workspace:*",
    "@tacet/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
