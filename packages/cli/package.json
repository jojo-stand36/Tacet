{
  "name": "tacet",
  "version": "0.0.0",
  "private": true,
  "description": "The tacet command-line interface.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@tacet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@tacet/conductor": "workspace:*",
    "@tacet/core": "workspace:*",
    "@tacet/mini": "workspace:*"
  },
  "bin": {
    "tacet": "./dist/bin.js"
  },
  "devDependencies": {
    "@xterm/headless": "6.0.0"
  }
}
