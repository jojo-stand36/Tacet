{
  "name": "@tacet/adapter-claude-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Claude adapter built on the Claude Agent SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@tacet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@tacet/source": "./src/testing/mock-messages-api.ts",
      "types": "./dist/testing/mock-messages-api.d.ts",
      "default": "./dist/testing/mock-messages-api.js"
    },
    "./launch": {
      "@tacet/source": "./src/launch.ts",
      "types": "./dist/launch.d.ts",
      "default": "./dist/launch.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@tacet/core": "workspace:*"
  }
}
