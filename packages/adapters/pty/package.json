{
  "name": "@tacet/adapter-pty",
  "version": "0.0.0",
  "private": true,
  "description": "PTY fallback adapter for agents without a structured interface.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@tacet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@tacet/source": "./src/testing/pty-gate.ts",
      "types": "./dist/testing/pty-gate.d.ts",
      "default": "./dist/testing/pty-gate.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@tacet/core": "workspace:*",
    "@tacet/adapter-claude-sdk": "workspace:*",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319"
  }
}
